+// GPU zones, sourced as the profiler's Statistics window does in GPU mode
+// (m_statMode == 2): Worker::GetGpuSourceLocationZones(). A zone's duration is
+// GpuEnd() - GpuStart(); the worker leaves out zones whose GpuEnd() is unset (< 0)
+// or whose duration is not positive, and the unwrap path repeats the first test.
+int export_gpu(const Args& args, const tracy::Worker& worker)
+{
+    while (!worker.AreGpuSourceLocationZonesReady())
+    {
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+
+    if (args.self_time)
+    {
+        fprintf(stderr, "Note: -e (self times) has no GPU form and is ignored with -g\n");
+    }
+
+    auto& slz = worker.GetGpuSourceLocationZones();
+
+    std::vector<const char*> columns;
+    if (args.unwrap)
+    {
+        columns = {
+            "name", "src_file", "src_line", "gpu_start_ns", "gpu_exec_time_ns", "thread"
+        };
+    }
+    else
+    {
+        columns = {
+            "name", "src_file", "src_line", "total_ns", "total_perc",
+            "counts", "mean_ns", "min_ns", "max_ns", "std_ns"
+        };
+    }
+    std::string header = join(columns, args.separator);
+    printf("%s\n", header.data());
+
+    const auto last_time = worker.GetLastTime();
+    for (auto it = slz.begin(); it != slz.end(); ++it)
+    {
+        const auto& zone_data = it->second;
+        if (zone_data.total == 0) continue;
+
+        const auto name = get_name(it->first, worker);
+        if (args.filter[0] != '\0' && !is_substring(args.filter, name, args.case_sensitive))
+        {
+            continue;
+        }
+
+        std::vector<std::string> values(columns.size());
+        values[0] = name;
+
+        const auto& srcloc = worker.GetSourceLocation(it->first);
+        values[1] = worker.GetString(srcloc.file);
+        values[2] = std::to_string(srcloc.line);
+
+        if (args.unwrap)
+        {
+            for (const auto& zone_thread_data : zone_data.zones)
+            {
+                const auto zone_event = zone_thread_data.Zone();
+                const auto start = zone_event->GpuStart();
+                const auto end = zone_event->GpuEnd();
+                if (end < 0) continue;
+
+                values[3] = std::to_string(start);
+                values[4] = std::to_string(end - start);
+                values[5] = std::to_string(zone_thread_data.Thread());
+
+                std::string row = join(values, args.separator);
+                printf("%s\n", row.data());
+            }
+        }
+        else
+        {
+            const auto time = zone_data.total;
+            values[3] = std::to_string(time);
+            values[4] = std::to_string(100. * time / last_time);
+
+            const auto sz = zone_data.zones.size();
+            values[5] = std::to_string(sz);
+
+            const auto avg = time / sz;
+            values[6] = std::to_string(avg);
+            values[7] = std::to_string(zone_data.min);
+            values[8] = std::to_string(zone_data.max);
+
+            const auto ss = zone_data.sumSq
+                - 2. * zone_data.total * avg
+                + avg * avg * sz;
+            double std = 0;
+            if (sz > 1)
+                std = sqrt(ss / (sz - 1));
+            values[9] = std::to_string(std);
+
+            std::string row = join(values, args.separator);
+            printf("%s\n", row.data());
+        }
+    }
+
+    return 0;
+}
